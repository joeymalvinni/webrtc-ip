{
    "name": "webrtc-ip",
    "type": "commonjs",
    "main": "dist/webrtc-ip.js",
    "module": "dist/webrtc-ip.mjs",
    "types": "dist/webrtc-ip.d.ts",
    "exports": {
        ".": {
            "types": "./dist/webrtc-ip.d.ts",
            "import": "./dist/webrtc-ip.mjs",
            "require": "./dist/webrtc-ip.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "scripts/build.js",
        "tsconfig.json",
        "tsconfig.esm.json",
        "README.md",
        "LICENSE"
    ],
    "author": "Joey Malvinni",
    "license": "Apache-2.0",
    "version": "5.0.0",
    "homepage": "https://joeymalvinni.github.io/webrtc-ip/",
    "description": "🌐 Enhanced IP address querying with WebRTC ",
    "bugs": {
        "url": "https://github.com/joeymalvinni/webrtc-ip/issues"
    },
    "scripts": {
        "build": "node scripts/build.js",
        "test": "npm run build && node --test tests/*.test.js",
        "prepack": "npm run build",
        "start": "cd website && npm run dev",
        "benchmark": "node scripts/benchmark-mock-browser.js",
        "benchmark:browser": "node scripts/serve-benchmark.js"
    },
    "keywords": [
        "webrtc",
        "ipv4",
        "ip-addresses",
        "ip-request",
        "webrtc-ip",
        "webrtc-ip-addresses"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/joeymalvinni/webrtc-ip.git"
    },
    "devDependencies": {
        "typescript": "^5.5.3"
    }
}
